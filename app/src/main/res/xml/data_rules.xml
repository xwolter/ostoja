<?xml version="1.0" encoding="utf-8"?>
<!-- Sejf jest szyfrowany kluczem z Android Keystore, który nie przechodzi na inne urządzenie,
     więc kopia w chmurze Google/Samsung byłaby bezużyteczna. Do przenosin służy eksport z hasłem. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
