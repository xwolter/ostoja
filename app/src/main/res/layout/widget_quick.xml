<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/wbg_glass" android:gravity="center_vertical"
    android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="8dp">

    <ImageView android:id="@+id/logo" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_logo" />
    <LinearLayout android:id="@+id/search" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
        android:layout_marginStart="8dp" android:background="@drawable/wbg_pill" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="12dp">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/w_search" android:tint="@color/w_text2" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:ellipsize="end" android:maxLines="1" android:text="Szukaj w sejfie" android:textColor="@color/w_text2" android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout android:id="@+id/b_scan" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="6dp">
        <ImageView android:id="@+id/b_scan_bg" android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/w_circle" android:tint="#223E91FF" />
        <ImageView android:id="@+id/b_scan_ic" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
            android:src="@drawable/w_qr" android:tint="#3E91FF" />
    </FrameLayout>
    <FrameLayout android:id="@+id/b_gen" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="6dp">
        <ImageView android:id="@+id/b_gen_bg" android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/w_circle" android:tint="#223E91FF" />
        <ImageView android:id="@+id/b_gen_ic" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
            android:src="@drawable/w_wand" android:tint="#3E91FF" />
    </FrameLayout>
    <FrameLayout android:id="@+id/b_add" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="6dp">
        <ImageView android:id="@+id/b_add_bg" android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/w_circle" android:tint="#3E91FF" />
        <ImageView android:id="@+id/b_add_ic" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
            android:src="@drawable/w_plus" android:tint="#FFFFFF" />
    </FrameLayout>
</LinearLayout>
